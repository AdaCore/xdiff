with "../../config/xdiff_config.gpr";
project C_Xdiff is

   for Languages use ("C");
   for Library_Name use "xdiff";
   for Library_Version use "lib" & Project'Library_Name & "." & Xdiff_Config.Crate_Version & Xdiff_Config.So_Ext;

   for Source_Dirs use ("src/");
   for Object_Dir use "obj/" & Xdiff_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("XDIFF_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   case Library_Type is
      when "relocatable" =>
         for Library_Options use Xdiff_Config.Ldflags;
      when others =>
         null;
   end case;

   package Compiler is
      for Default_Switches ("C") use
          (
            "-O3" -- Optimize for performance
           ,"-g" -- Generate debug info
          );
      for Switches ("C") use Compiler'Switches ("C") & Xdiff_Config.Cflags;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end C_Xdiff;
